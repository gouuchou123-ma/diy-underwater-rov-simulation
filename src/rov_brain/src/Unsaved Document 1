import rclpy
from std_msgs.msg import Float64

class MotorPlugin:
    def init(self, webots_node, properties):
        self.__robot = webots_node.robot
        
        # Tìm cái mô-tơ trong Webots bằng đúng tên bạn đã đặt
        self.__motor = self.__robot.getDevice('thruster_1')
        
        # Mở chốt an toàn: Chuyển mô-tơ sang chế độ quay liên tục (Velocity Control)
        self.__motor.setPosition(float('inf'))
        self.__motor.setVelocity(0.0)

        # Đeo tai nghe vào: Bắt đầu lắng nghe cái Topic mà C++ đang phát
        webots_node.create_subscription(
            Float64, 
            '/thruster_1/cmd_vel', 
            self.__cmd_callback, 
            10
        )

    # Mỗi khi C++ gửi số 10.0 đến, hàm này sẽ lấy số đó ép mô-tơ quay
    def __cmd_callback(self, msg):
        self.__motor.setVelocity(msg.data)

    def step(self):
        pass
