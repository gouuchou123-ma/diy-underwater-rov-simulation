  <!-- ========================================== -->
  <!-- 1. TẠO THỂ XÁC VẬT LÝ CHO IMU (Frame_id)   -->
  <!-- ========================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- 2. KHAI BÁO DRIVER WEBOTS-ROS2             -->
  <!-- ========================================== -->
  <webots>
    <!-- Plugin Động cơ -->
    <plugin type="motor_plugin.MotorPlugin" />

    <!-- Cảm biến Độ sâu (GPS) -->
    <device reference="base_link" type="GPS">
      <ros>
        <enabled>true</enabled>
        <alwaysOn>true</alwaysOn>
        <updateRate>10</updateRate> 
        <topicName>/sensor/depth</topicName>
      </ros>
    </device>

    <!-- Khai báo Motor -->
    <motor reference="joint_thruster_1" maxVelocity="500.0"/>
    <motor reference="joint_thruster_2" maxVelocity="500.0"/>
    <motor reference="joint_thruster_3" maxVelocity="500.0"/>
    <motor reference="joint_thruster_5" maxVelocity="500.0"/>
    <motor reference="joint_thruster_6" maxVelocity="500.0"/>
    <motor reference="joint_thruster_7" maxVelocity="500.0"/>

    <!-- PLUGIN GỘP IMU (Chuẩn hóa cho Foxglove) -->
    <plugin type="webots_ros2_driver::Ros2IMU">
        <enabled>true</enabled>
        <topicName>/imu</topicName>
        <alwaysOn>true</alwaysOn>
        <!-- Bắt buộc phải trỏ về cái Thể xác vật lý vừa tạo ở trên -->
        <frameName>imu_link</frameName>
        <!-- Trỏ đúng tên node InertialUnit và Gyro trong Webots -->
        <inertialUnitName>imu</inertialUnitName>
        <gyroName>gyro</gyroName>
    </plugin>
  </webots>
</robot>
